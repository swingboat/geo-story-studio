{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toutiao article recipe",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "build_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]{3,}$"
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "titles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "selected_title": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "media": {
      "type": "array",
      "items": { "$ref": "#/$defs/media" }
    },
    "cover": {
      "type": "object",
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "show_in_article": { "type": "boolean" },
        "lines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "source_diagram_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 3
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "lines",
        "subtitle",
        "source_diagram_ids",
        "claim_ids",
        "alt"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "claim_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "text",
                "claim_ids"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "figure_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "heading",
          "paragraphs",
          "figure_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^figure-[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "single",
              "comparison",
              "asset"
            ]
          },
          "asset_id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_diagram_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 0
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "subtitle": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "title",
                "subtitle"
              ],
              "additionalProperties": false
            }
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "source_diagram_ids",
          "labels",
          "caption",
          "alt",
          "claim_ids"
        ],
        "additionalProperties": false,
        "allOf": [
          { "if": { "properties": { "kind": { "const": "asset" } } },
            "then": { "required": ["asset_id", "purpose"], "properties": { "labels": { "maxItems": 0 } } },
            "else": { "properties": { "source_diagram_ids": { "minItems": 1 } } } }
        ]
      },
      "minItems": 1
    },
    "change_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "diagram_id": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "figure_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "diagram_id",
          "instruction",
          "resolution",
          "figure_ids"
        ],
        "additionalProperties": false
      }
    },
    "editorial_review": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "type",
        "name",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "build_id",
    "version",
    "topic_id",
    "titles",
    "selected_title",
    "summary",
    "tags",
    "audience",
    "cover",
    "sections",
    "figures",
    "change_resolutions",
    "editorial_review"
  ],
  "additionalProperties": false,
  "$defs": {
    "media": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kind": { "enum": ["photograph", "illustration", "composition"] },
        "credit": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "rights_url": { "type": "string", "format": "uri" },
        "rights_notes": { "type": "string", "minLength": 1 },
        "adaptation": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "derived_from": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "required": ["id", "path", "sha256", "kind", "credit", "rights_notes", "adaptation", "verified_at"],
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "kind": { "const": "photograph" } } },
          "then": { "required": ["source_url", "rights_url", "width", "height"] } }
      ]
    }
  }
}
