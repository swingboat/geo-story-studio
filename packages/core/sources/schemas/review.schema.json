{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific review record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "$ref": "source-manifest.schema.json#/$defs/source_ref"
    },
    "extraction_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "name"
      ],
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "properties": {
        "name": {
          "const": "review-science"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "instructions_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "instructions_sha256"
      ],
      "additionalProperties": false
    },
    "input_hashes": {
      "type": "object",
      "properties": {
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "knowledge_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "content_sha256",
        "knowledge_sha256"
      ],
      "additionalProperties": false
    },
    "scope_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "section",
          "accessed_on",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "original_text": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "knowledge_point_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "related_review_item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "decision": {
            "enum": [
              "supported",
              "revise",
              "qualify",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "recommended_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "original_text",
          "source_refs",
          "knowledge_point_ids",
          "related_review_item_ids",
          "decision",
          "reason",
          "recommended_text",
          "evidence_ids",
          "scope",
          "constraints"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "unresolved"
                }
              }
            },
            "then": {
              "properties": {
                "recommended_text": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "recommended_text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "diagram_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "diagram_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "reuse",
              "revise",
              "unresolved"
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "diagram_id",
          "decision",
          "claim_ids",
          "requirements"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "enum": [
                    "revise",
                    "unresolved"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "topic_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic_id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "diagram_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "topic_id",
          "scope",
          "claim_ids",
          "diagram_ids",
          "constraints"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "source_ref",
    "extraction_id",
    "reviewed_at",
    "reviewer",
    "skill",
    "input_hashes",
    "scope_notes",
    "evidence",
    "claims",
    "diagram_reviews",
    "topic_plans"
  ],
  "additionalProperties": false,
  "$defs": {
    "skill": {
      "type": "object",
      "properties": {
        "name": {
          "const": "review-science"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "instructions_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "instructions_sha256"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "accessed_on": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "section",
        "accessed_on",
        "note"
      ],
      "additionalProperties": false
    },
    "diagram_review": {
      "type": "object",
      "properties": {
        "diagram_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "reuse",
            "revise",
            "unresolved"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "diagram_id",
        "decision",
        "claim_ids",
        "requirements"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "enum": [
                  "revise",
                  "unresolved"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
