{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local source registry",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "input_path": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_version": {
                  "type": "string",
                  "pattern": "^v[0-9]{3,}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "manifest_path": {
                  "type": "string"
                }
              },
              "required": [
                "source_version",
                "sha256",
                "manifest_path"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "source_id",
          "input_path",
          "versions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false
}
