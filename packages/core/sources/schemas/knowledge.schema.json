{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge material awaiting science review",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_ref": {
      "$ref": "source-manifest.schema.json#/$defs/source_ref"
    },
    "extraction_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "status": {
      "const": "pending_science_review"
    },
    "knowledge_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "diagram_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "verification_status": {
            "const": "unverified"
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "source_refs",
          "diagram_ids",
          "verification_status"
        ],
        "additionalProperties": false
      }
    },
    "review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source_quote": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "status": {
            "const": "pending"
          }
        },
        "required": [
          "id",
          "source_quote",
          "reason",
          "source_refs",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "candidate_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "angle": {
            "type": "string"
          },
          "knowledge_point_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "diagram_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "angle",
          "knowledge_point_ids",
          "source_refs",
          "diagram_ids"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "title",
          "url",
          "source_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_ref",
    "extraction_id",
    "status",
    "knowledge_points",
    "review_items",
    "candidate_topics",
    "references"
  ],
  "additionalProperties": false
}
